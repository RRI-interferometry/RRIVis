      "required": [
        "case_id",
        "invariant_id",
        "backend",
        "test_node_id",
        "input_manifest_sha256",
        "expected",
        "observed",
        "max_abs_residual",
        "max_rel_residual",
        "atol",
        "rtol",
        "passed"
      ]
    },
    "rejection_probe": {
