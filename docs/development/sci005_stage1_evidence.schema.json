{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radiosim.invalid/schema/sci005_stage1_evidence.schema.json",
  "title": "SCI-005 Stage-1 retained evidence record",
  "description": "Literal transcription of docs/development/sci005_beam_physics_plan.md Section 8.1's Stage-1 evidence contract. Cross-field, ordering, and digest predicates that JSON Schema cannot express are mandatory validator checks in tests/unit/test_sci005_evidence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "status",
    "generated_at_utc",
    "design_sha",
    "red_test_sha",
    "source_sha",
    "evidence_sha",
    "working_tree_clean",
    "radiosim_version",
    "python_version",
    "platform",
    "machine",
    "pixi_environment",
    "pixi_lock_sha256",
    "scientific_conventions",
    "config_cases",
    "analytic_invariants",
    "rejection_probes",
    "backend_parity",
    "solver_cases",
    "output_cases",
    "fingerprint_diff",
    "commands",
    "artifacts",
    "limitations",
    "claims_not_licensed",
    "pupil_profiles",
    "support_masks",
    "ruze_power_diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "radiosim.sci005.stage1.v1"
    },
    "stage": {
      "const": 1
    },
    "status": {
      "const": "candidate"
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "design_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "red_test_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_sha": {
      "type": "null"
    },
    "working_tree_clean": {
      "const": true
    },
    "radiosim_version": {
      "type": "string",
      "minLength": 1
    },
    "python_version": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "machine": {
      "type": "string",
      "minLength": 1
    },
    "pixi_environment": {
      "type": "string",
      "minLength": 1
    },
    "pixi_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scientific_conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pupil_profile_set": {
          "const": "radiosim.circular_stage1_pupil_profiles.v1"
        },
        "aperture_normalization": {
          "const": "unmodified_ideal_aperture_v1"
        },
        "aperture_axes": {
          "const": "north_east_azimuth_north_through_east_v1"
        },
        "support_mask": {
          "const": "radiosim.central_disk_outward_half_strip_ne.v1"
        },
        "zernike_surface": {
          "const": "radiosim.real_unit_rms_disk_surface_height.v1"
        },
        "aperture_method": {
          "const": "boundary_fitted_polar_gauss_legendre_v1"
        },
        "ruze_covariance": {
          "const": "gaussian_one_over_e_surface_covariance_v1"
        },
        "ruze_method": {
          "const": "poisson_paired_pupil_separation_v1"
        }
      },
      "required": [
        "pupil_profile_set",
        "aperture_normalization",
        "aperture_axes",
        "support_mask",
        "zernike_surface",
        "aperture_method",
        "ruze_covariance",
        "ruze_method"
      ]
    },
    "config_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/config_case"
      }
    },
    "analytic_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/analytic_invariant"
      }
    },
    "rejection_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rejection_probe"
      }
    },
    "backend_parity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/backend_parity"
      }
    },
    "solver_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/solver_case"
      }
    },
    "output_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output_case"
      }
    },
    "fingerprint_diff": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fingerprint_row"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command_row"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact_row"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claims_not_licensed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "pupil_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pupil_profile"
      }
    },
    "support_masks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/support_mask"
      }
    },
    "ruze_power_diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ruze_power_diagnostics_row"
      }
    }
  },
  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "canonical_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)(?!.*/$).+$"
    },
    "numeric_projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "float32",
            "float64",
            "float128",
            "complex64",
            "complex128",
            "complex256"
          ]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "c_order_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "minimum_abs": {
          "type": "number",
          "minimum": 0
        },
        "maximum_abs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "dtype",
        "shape",
        "c_order_sha256",
        "minimum_abs",
        "maximum_abs"
      ]
    },
    "array_projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "float32",
            "float64"
          ]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "c_order_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "required": [
        "dtype",
        "shape",
        "c_order_sha256",
        "minimum",
        "maximum"
      ]
    },
    "antenna_projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "number",
        "name"
      ]
    },
    "command_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "const": "."
        },
        "pixi_environment": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stderr_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "argv",
        "cwd",
        "pixi_environment",
        "started_at_utc",
        "duration_seconds",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256"
      ]
    },
    "artifact_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)(?!.*/$).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "schema",
            "command_log",
            "output",
            "fingerprint",
            "auxiliary"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "role"
      ]
    },
    "config_case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "test_node_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_outcome": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "observed_outcome": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "resolved_scientific_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "exception_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "issue_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "test_node_id",
        "input_sha256",
        "expected_outcome",
        "observed_outcome",
        "resolved_scientific_sha256",
        "exception_type",
        "issue_code",
        "exact_message",
        "passed"
      ]
    },
    "analytic_invariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
