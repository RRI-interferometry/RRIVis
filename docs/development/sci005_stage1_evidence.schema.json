        "exception_type": {
          "type": "string",
          "minLength": 1
        },
        "issue_code": {
          "type": "string",
          "minLength": 1
        },
        "exact_message": {
          "type": "string",
          "minLength": 1
        },
        "test_node_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "passed": {
          "type": "boolean"
