          "minLength": 1
        },
        "effect": {
          "enum": [
            "squint_point",
            "squint_healpix"
          ]
        },
        "test_node_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "jones_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "visibility_sha256": {
