      "required": [
        "case_id",
        "backend",
        "actual_device",
        "real_dtype",
        "complex_dtype",
        "input_sha256",
        "reference_result_sha256",
        "observed_result_sha256",
        "max_abs_difference",
        "max_rel_difference",
        "atol",
